{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Silico verifier-response v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "verdict": {
      "enum": [
        "pass",
        "repair",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "scenario_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "check_id",
          "status",
          "scenario_ids",
          "evidence"
        ]
      }
    },
    "repair_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "rerun_scenario",
              "revise_plan",
              "request_clarification"
            ]
          },
          "scenario_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "action",
          "scenario_ids",
          "check_ids",
          "reason"
        ]
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "plan_hash",
    "round",
    "verdict",
    "checks",
    "repair_requests",
    "summary"
  ]
}
