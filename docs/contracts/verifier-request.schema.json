{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Silico verifier-request v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "simulation_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "audience_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scenario_id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "scenario_id",
              "question",
              "description",
              "options",
              "assumptions"
            ]
          },
          "minItems": 2,
          "maxItems": 3
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "coverage",
                  "context",
                  "probabilities",
                  "arithmetic",
                  "semantic",
                  "sources"
                ]
              },
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "scenario_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "check_id",
              "kind",
              "requirement",
              "scenario_ids"
            ]
          },
          "minItems": 1
        },
        "max_repair_rounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "goal",
        "city",
        "simulation_id",
        "workspace",
        "audience_hash",
        "context_hash",
        "as_of_date",
        "model",
        "scenarios",
        "checks",
        "max_repair_rounds"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "complete",
              "failed"
            ]
          },
          "audience_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "context_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "as_of_date": {
            "type": "string",
            "format": "date"
          },
          "expected_archetype_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "answered_archetype_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "distribution": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "option": {
                  "type": "string",
                  "minLength": 1
                },
                "probability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "option",
                "probability"
              ]
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "scenario_id",
          "attempt",
          "status",
          "audience_hash",
          "context_hash",
          "model",
          "as_of_date",
          "expected_archetype_ids",
          "answered_archetype_ids",
          "distribution",
          "error"
        ]
      }
    },
    "deterministic_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "scenario_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "check_id",
          "status",
          "scenario_ids",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "plan_hash",
    "round",
    "plan",
    "results",
    "deterministic_checks"
  ]
}
